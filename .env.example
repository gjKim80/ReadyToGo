# ReadyToGo 서버리스 프록시 환경변수
# 로컬에서 `vercel dev`로 테스트할 때는 이 파일을 .env.local 로 복사해 값을 채운다.
# 배포 환경에는 `vercel env add <NAME> production` 으로 넣는다. (git에 커밋하지 말 것)

# ── 1) NAVER Cloud Platform · Maps (자차 경로 · 장소 검색/좌표변환) ──────────────
# 콘솔 > Services > AI·NAVER API(또는 Maps) > Application 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 2) 기상청 단기예보 (날씨) ────────────────────────────────────────────────
# 공공데이터포털(data.go.kr) > "기상청_단기예보 조회서비스" 활용신청 > 일반 인증키
# 인코딩 키/디코딩 키 아무 쪽이나 넣어도 동작한다.
KMA_SERVICE_KEY=

# ── 3) NAVER Developers 지역 검색 (상호명 검색 · 선택) ────────────────────────
# developers.naver.com > 애플리케이션 등록 > 검색 API 사용 (NCP 키와 다른 키다)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── 4) 대중교통 경로 (미구현 · 예약) ──────────────────────────────────────────
# ODsay 대중교통 길찾기 API 키. 현재 코드는 사용하지 않는다.
ODSAY_API_KEY=

# ── 5) CORS 허용 오리진 (쉼표 구분, 비우면 전체 허용) ─────────────────────────
# 예: https://gjkim80.github.io,http://localhost:5173
ALLOWED_ORIGINS=
